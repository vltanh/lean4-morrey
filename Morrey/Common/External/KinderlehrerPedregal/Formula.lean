module

public import Morrey.Common.Basic.CalculusOfVariations.Basic

/-!
# Kinderlehrer–Pedregal: Dacorogna's formula for the quasiconvex envelope

D. Kinderlehrer and P. Pedregal, *Characterizations of Young measures generated by gradients*,
Arch. Rational Mech. Anal. 115 (1991), Proposition 8.1. Cassese quotes it as Proposition 2.2.
Building it is a large but feasible effort (class L of the inventory); until the user decides,
it is a proposition with no proof, and a hypothesis of every statement whose proof uses it.
-/

@[expose] public section

open MeasureTheory

namespace External.KinderlehrerPedregal

open CalculusOfVariations

/-- **Proposition 2.2** (`cs-prop2.2`) of Cassese, citing Kinderlehrer–Pedregal, Proposition 8.1
(Dacorogna's formula): for a continuous integrand `f : ℝ^{d×m} → ℝ` and every `A`,
`f^{qc} (A) = inf_φ ⨍_{B(0,1)} f (A + ∇φ)` over the Lipschitz `φ` vanishing outside the unit
ball `B(0,1)` (that is, `φ ∈ W^{1,∞}_0 (B(0,1), ℝ^d)`). Values in `EReal`. -/
def DacorognaFormula : Prop :=
  ∀ (d m : ℕ) (f : Matrix (Fin d) (Fin m) ℝ → ℝ), Continuous f → ∀ A : Matrix (Fin d) (Fin m) ℝ,
    qcEnvelope f A =
      ⨅ (φ : (Fin m → ℝ) → Fin d → ℝ) (_ : (∃ K, LipschitzWith K φ) ∧ ∀ x ∉ unitBall m, φ x = 0),
        (((volume (unitBall m)).toReal⁻¹ * ∫ x in unitBall m, f (A + grad φ x) : ℝ) : EReal)

end External.KinderlehrerPedregal
